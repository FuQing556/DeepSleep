# 默认把可识别文本规范为 LF，避免 Windows 与其他平台反复改换行符。
* text=auto

# 工程文本
*.cs              text eol=lf
*.md              text eol=lf whitespace=-blank-at-eol
*.txt             text eol=lf
*.json            text eol=lf
*.xml             text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.gitignore       text eol=lf
*.gitattributes   text eol=lf
*.ps1             text eol=crlf

# Unity 的 YAML 与配置文本必须保留为可审查差异。
*.meta            text eol=lf whitespace=-blank-at-eol
*.unity           text eol=lf whitespace=-blank-at-eol
*.prefab          text eol=lf whitespace=-blank-at-eol
*.asset           text eol=lf whitespace=-blank-at-eol
*.mat             text eol=lf whitespace=-blank-at-eol
*.anim            text eol=lf whitespace=-blank-at-eol
*.controller      text eol=lf whitespace=-blank-at-eol
*.overrideController text eol=lf whitespace=-blank-at-eol
*.asmdef          text eol=lf
*.asmref          text eol=lf
*.inputactions    text eol=lf whitespace=-blank-at-eol
*.scenetemplate   text eol=lf whitespace=-blank-at-eol
*.shader          text eol=lf
*.compute         text eol=lf
*.shadergraph     text eol=lf
*.shadersubgraph  text eol=lf
*.uxml            text eol=lf
*.uss             text eol=lf

# 不适合普通 Git 差异比较的生产素材从第一次提交起进入 Git LFS。
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.webp  filter=lfs diff=lfs merge=lfs -text
*.gif   filter=lfs diff=lfs merge=lfs -text
*.bmp   filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
*.tif   filter=lfs diff=lfs merge=lfs -text
*.tiff  filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.psb   filter=lfs diff=lfs merge=lfs -text
*.kra   filter=lfs diff=lfs merge=lfs -text
*.clip  filter=lfs diff=lfs merge=lfs -text
*.ase   filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text

*.wav   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.flac  filter=lfs diff=lfs merge=lfs -text
*.aiff  filter=lfs diff=lfs merge=lfs -text
*.m4a   filter=lfs diff=lfs merge=lfs -text

*.mp4   filter=lfs diff=lfs merge=lfs -text
