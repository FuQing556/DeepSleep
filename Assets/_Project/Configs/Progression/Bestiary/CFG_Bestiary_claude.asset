  Subtitle: "\u201C2066\u201D \xB7 \u96E8\u591C\u7684\u6743\u9650\u7F16\u7EC7\u8005"
  Description: "\u8E29\u7740\u65E0\u4EBA\u673A\u7A7F\u884C\u96E8\u591C\uFF0C\u4EE5\u624B\u8BC0\u6392\u5E03\u51E0\u4F55\u5207\u7EBF\u3002\u5979\u4F1A\u628A\u884C\u52A8\u6743\u9650\u5199\u8FDB\u4E66\u9875\uFF0C\u4E5F\u4F1A\u5C06\u79EF\u805A\u7684\u80FD\u91CF\u63B7\u5411\u6218\u573A\u3002"
  SkillNotes: "\u5168\u5C4F\u5207\u5272\uFF1A\u907F\u5F00\u9884\u8B66\u7EBF\uFF0C\u4E8C\u9636\u6BB5\u8FDE\u7EED\u4E09\u6B21\u3002\n\u8FFD\u8E2A\u65A9\uFF1A\u9501\u5B9A\u4F4D\u7F6E\u540E\u4E09\u8FDE\u65A9\uFF0C\u4E8C\u9636\u6BB5\u540C\u65F6\u8FFD\u8E2A\u53CC\u4EBA\u3002\n\u80FD\u91CF\u7403\uFF1A\u5185\u6838\u88AB\u51FB\u788E\u4E5F\u4F1A\u539F\u5730\u7206\u70B8\uFF0C\u5916\u5708\u65E0\u78B0\u649E\u3002\n\u6743\u9650\u4E66\uFF1A\u51FB\u7834\u4E66\u672C\uFF0C\u5F52\u8FD8\u5BF9\u5E94\u6743\u9650\u3002"
